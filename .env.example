# Example environment variables for Yard-services
SECRET_KEY=replace-me

# Local database path
DB_LOCAL_PATH=yard.db

# Email (Flask-Mail)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Notifications
NOTIFICATION_WEBHOOK_URL=

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_TO_PHONE=
